# ===== Batak Tournament - Production Environment =====

# Environment
NODE_ENV=production

# Server Configuration
PORT=3001
HOST_PORT=80

# JWT Secret (REQUIRED - generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Optional: Server wallet for cNFT minting (leave empty for MVP)
# If empty, cNFT rewards will be mocked
SOLANA_PRIVATE_KEY=

# Solana Program ID (deployed on devnet)
PROGRAM_ID=5ZdgoyBDknoZ8tDYMDXf8zCUQ7FxuaDbK4QffAgSfA9h

# Optional: Merkle Tree address for cNFT minting (leave empty for MVP)
# Create with: nft minting features will be mocked
MERKLE_TREE=

# Default Game Settings
DEFAULT_BOT_DIFFICULTY=normal
DEFAULT_BOT_COUNT=3
