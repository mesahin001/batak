# BATAK - Production Environment Variables

# ============================================
# SERVER CONFIG
# ============================================
NODE_ENV=production
PORT=3001

# ============================================
# DATABASE CONFIG
# ============================================
DATABASE_URL=postgresql://batak:YOUR_PASSWORD@localhost:5432/batak
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# ============================================
# REDIS CONFIG
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# SOLANA CONFIG
# ============================================
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
PROGRAM_ID=5ZdgoyBDknoZ8tDYMDXf8zCUQ7FxuaDbK4QffAgSfA9h

# SOLANA PRIVATE KEY (Server wallet for transactions)
# WARNING: NEVER commit this to git!
SOLANA_PRIVATE_KEY=

# ============================================
# MERKLE TREE (for cNFT minting)
# ============================================
MERKLE_TREE=

# ============================================
# GAME CONFIG
# ============================================
MAX_PLAYERS=4
DEFAULT_BOT_DIFFICULTY=normal
GAME_TIMEOUT=300000

# ============================================
# SECURITY
# ============================================
JWT_SECRET=CHANGE_THIS_RANDOM_STRING
CORS_ORIGIN=https://yourdomain.com

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=
DATADOG_API_KEY=

# ============================================
# PGADMIN (Optional - for database management)
# ============================================
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_THIS_TOO
