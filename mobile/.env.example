# Batak Mobile - Environment Variables Template
# Copy this file to .env and configure for your environment

# Socket Server URL
# Development: Use your computer's local IP address
# Production: Use wss:// with domain name
EXPO_PUBLIC_SOCKET_URL=ws://192.168.1.XXX:3001

# Solana Network
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# Solana Program ID
EXPO_PUBLIC_PROGRAM_ID=5ZdgoyBDknoZ8tDYMDXf8zCUQ7FxuaDbK4QffAgSfA9h

# Default Game Settings
EXPO_PUBLIC_DEFAULT_BOT_DIFFICULTY=normal
# Default to PvP mode (0 bots) - waits 60s for real players, then adds bots as fallback
# Options: 0 (PvP), 1-2 (mixed), 3 (instant bots)
EXPO_PUBLIC_DEFAULT_BOT_COUNT=0
