{
  "expo": {
    "name": "Batak Tournament",
    "slug": "BatakMobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "description": "Turkish trick-taking card game with Solana blockchain rewards. Play Koz Maça and İhaleli Batak modes, compete in tournaments, and earn cNFT rewards.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bataktournament.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.bataktournament.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "screenOrientation": "unspecified",
      "softwareKeyboardLayoutMode": "pan",
      "statusBar": {
        "barStyle": "light-content",
        "backgroundColor": "#1a1a2e",
        "hidden": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "batak-tournament"
      }
    },
    "plugins": []
  }
}
