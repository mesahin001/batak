# Server Configuration
# Port for the HTTP/WebSocket server
PORT=3001

# JWT secret for auth token signing (REQUIRED in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=changeme-in-production

# Node environment (development, production, test)
NODE_ENV=development

# Solana Configuration
# RPC endpoint URL for Solana network
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana wallet for cNFT minting (REQUIRED for hackathon submission)
# Generate with: cd server && npm run create-wallet
# This will create a wallet.json backup and output the private key below
# Format: JSON array of numbers e.g., [1,2,3,...]
SOLANA_PRIVATE_KEY=

# Solana network to connect to (mainnet-beta, testnet, devnet, localnet)
SOLANA_NETWORK=devnet

# Smart Contract Configuration
# Deployed Batak Tournament program ID on Solana
# Deploy with: anchor deploy
PROGRAM_ID=

# Merkle tree address for cNFTs (REQUIRED for cNFT minting)
# Create with: cd server && npm run setup-tree
# After creation, the tree address will be output - copy it here
# Without this, cNFT minting will be mocked (no real NFTs created)
MERKLE_TREE=

# nft.storage API key for IPFS metadata upload (free at https://nft.storage)
# Without this, metadata is saved locally and served via NFT_METADATA_BASE_URL
# Get a free key at https://nft.storage
NFT_STORAGE_KEY=

# Base URL for self-hosted NFT metadata (used when NFT_STORAGE_KEY is not set)
# Must be publicly accessible so Solana validators can fetch metadata
NFT_METADATA_BASE_URL=https://batakci.xyz

# IPFS URI for the NFT trophy image (optional, has default)
# NFT_IMAGE_URI=https://ipfs.io/ipfs/<your-cid>

# Game Configuration
# Maximum players per game (default: 4 for Batak)
MAX_PLAYERS=4

# Default bot difficulty (easy, normal, hard)
DEFAULT_BOT_DIFFICULTY=normal

# Game timeout in milliseconds (5 minutes = 300000ms)
GAME_TIMEOUT=300000

# Optional: Additional Configuration
# Number of rounds per tournament (5, 7, 9, or 11)
# TOTAL_ROUNDS=5

# Bot count for matchmaking (0-3, where 4-botCount = human players)
# DEFAULT_BOT_COUNT=3
