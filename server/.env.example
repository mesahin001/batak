# Server Configuration
# Port for the HTTP/WebSocket server
PORT=3001

# Node environment (development, production, test)
NODE_ENV=development

# Solana Configuration
# RPC endpoint URL for Solana network
SOLANA_RPC_URL=https://api.devnet.solana.com

# Base58-encoded Solana private key for server wallet
# Generate with: solana-keygen new --outfile ~/.config/solana/id.json
# Then get base58: solana-keygen pubkey ~/.config/solana/id.json
SOLANA_PRIVATE_KEY=

# Solana network to connect to (mainnet-beta, testnet, devnet, localnet)
SOLANA_NETWORK=devnet

# Smart Contract Configuration
# Deployed Batak Tournament program ID on Solana
# Deploy with: anchor deploy
PROGRAM_ID=

# Merkle tree address for compressed NFTs (cNFTs)
# Create with Metaplex Bubblegum CLI or via initialization script
MERKLE_TREE=

# Game Configuration
# Maximum players per game (default: 4 for Batak)
MAX_PLAYERS=4

# Default bot difficulty (easy, normal, hard)
DEFAULT_BOT_DIFFICULTY=normal

# Game timeout in milliseconds (5 minutes = 300000ms)
GAME_TIMEOUT=300000

# Optional: Additional Configuration
# Number of rounds per tournament (5, 7, 9, or 11)
# TOTAL_ROUNDS=5

# Bot count for matchmaking (0-3, where 4-botCount = human players)
# DEFAULT_BOT_COUNT=3
